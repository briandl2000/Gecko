# Gecko: local Pi / aarch64 developer config.
#
# Copy to `.gecko-pi.env` (gitignored) and fill in your values.
# Sourced by scripts/pi-dev.sh.

# SSH target: user@host or host alias from ~/.ssh/config
GECKO_PI_HOST="pi@raspberrypi.local"

# Remote directory where binaries/tests land. `~` is expanded on the Pi.
GECKO_PI_DIR="~/gecko"

# Port used by `gk-pi gdbserver` and the matching VS Code remote-debug launch.
GECKO_PI_GDB_PORT="2345"
