{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/build/$penv{GECKO_PLATFORM_ID}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      },
      "environment": {
        "GECKO_PLATFORM_ID": "$penv{GECKO_PLATFORM_ID}"
      },
      "errors": {
        "deprecated": true
      },
      "condition": {
        "type": "notEquals",
        "lhs": "$penv{GECKO_PLATFORM_ID}",
        "rhs": ""
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (Ninja Multi-Config)",
      "inherits": "base"
    },
    {
      "name": "release",
      "displayName": "Release (Ninja Multi-Config)",
      "inherits": "base"
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ] 
}

