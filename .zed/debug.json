[
  {
    "label": "Gecko: Build & Debug Launcher",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "python3",
      "args": ["build.py", "sandbox"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/out/Linux-x86_64/Debug/bin/gecko_launcher",
    "cwd": "$ZED_WORKTREE_ROOT/out/Linux-x86_64/Debug/bin"
  },
  {
    "label": "Gecko: Debug Headless Smoke",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "python3",
      "args": ["build.py", "sandbox"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/out/Linux-x86_64/Debug/bin/gecko_launcher",
    "args": ["--backend=null", "--graphics=null", "--frames=2"],
    "cwd": "$ZED_WORKTREE_ROOT/out/Linux-x86_64/Debug/bin"
  }
]
