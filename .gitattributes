# Gecko Framework - Git Attributes

# Default: auto-detect text files, normalise to LF in repo
* text=auto

# Force LF for source files (even on Windows checkouts)
*.cpp text eol=lf
*.h   text eol=lf
*.c   text eol=lf
*.cmake text eol=lf
*.py  text eol=lf
*.sh  text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf

# Force CRLF for Windows-specific scripts
*.bat  text eol=crlf
*.ps1  text eol=crlf

# Binary files — never diff or merge
*.png  binary
*.jpg  binary
*.ico  binary
*.exe  binary
*.dll  binary
*.so   binary
*.dylib binary
*.a    binary
*.lib  binary
*.zip  binary
*.tar.gz binary
