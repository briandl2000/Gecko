#!/usr/bin/env bash
#------------------------------------------------------------
# Gecko pre-commit hook
#------------------------------------------------------------
# Verifies staged C++ files pass clang-format.
# Installed by: gk setup / source scripts/setup.sh

set -euo pipefail

# Collect staged C++ files (added, copied, modified, renamed)
mapfile -t staged < <(
  git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.h' 2>/dev/null
)

if [[ ${#staged[@]} -eq 0 ]]; then
  exit 0
fi

if ! command -v clang-format &>/dev/null; then
  echo "pre-commit: clang-format not found — skipping format check."
  exit 0
fi

failed=()
for file in "${staged[@]}"; do
  # Check the staged version, not the working tree
  if ! git show ":$file" | clang-format --dry-run --Werror --assume-filename="$file" 2>/dev/null; then
    failed+=("$file")
  fi
done

if [[ ${#failed[@]} -gt 0 ]]; then
  echo ""
  echo "pre-commit: The following files are not formatted correctly:"
  for f in "${failed[@]}"; do
    echo "  $f"
  done
  echo ""
  echo "Run 'gk format' to fix, then re-stage and commit."
  exit 1
fi
